# ==============================================================================
# Environment Configuration Template for Docker Compose & Local Development
# ==============================================================================

# PostgreSQL Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iyeob_lab
POSTGRES_PORT=5432

# FastAPI Backend Service Configuration
PROJECT_NAME="Ubasify Practical Labs API"
ENVIRONMENT=development
DEBUG=true
BACKEND_PORT=5000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://frontend:3000","http://localhost:8080"]

# Next.js Frontend Service Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:5000
